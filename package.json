{
  "name": "app-account-kit",
  "version": "10.1.1",
  "description": "Reusable Account screen for React Native / Expo apps: profile, nickname, photo, change password page, data download, about (share, rate, privacy, support, version), sign out and delete account. Takes its whole theme from the app (no colors of its own), with slots for each app's own settings.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./logic": "./src/logic/index.ts",
    "./photo": "./src/photo/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "sideEffects": false,
  "license": "MIT",
  "author": "Yuvaraj Salla",
  "peerDependencies": {
    "@expo/vector-icons": ">=14",
    "app-core-kit": ">=1.11.0",
    "expo-image-manipulator": ">=13",
    "expo-image-picker": ">=16",
    "react": ">=18",
    "react-native": ">=0.74"
  },
  "peerDependenciesMeta": {
    "expo-image-manipulator": {
      "optional": true
    },
    "expo-image-picker": {
      "optional": true
    }
  },
  "devDependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.1",
    "app-core-kit": "git+https://github.com/yuvarajsalla20/app-core-kit.git#c9457e9c7908078a368af3c6f03e5d022baf26f8",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-test-renderer": "^19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^2.1.9"
  }
}
